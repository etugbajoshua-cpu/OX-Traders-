{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered OX TRADERS investor account (PII restricted to owner and admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "country": { "type": "string", "maxLength": 80 },
        "referralCode": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "referredBy": { "type": "string", "maxLength": 32 },
        "isVerified": { "type": "boolean" },
        "twoFactorEnabled": { "type": "boolean" },
        "kycStatus": {
          "type": "string",
          "enum": ["not_submitted", "pending", "verified", "rejected", "additional_info_required"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "restricted"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "referralCode", "isVerified", "twoFactorEnabled", "kycStatus", "status", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Multi-currency ledger balances for an investor (USD, BTC, USDT).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "usdAvailable": { "type": "number" },
        "usdLocked": { "type": "number" },
        "btcAvailable": { "type": "number" },
        "btcLocked": { "type": "number" },
        "usdtAvailable": { "type": "number" },
        "usdtLocked": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "usdAvailable", "usdLocked", "btcAvailable", "btcLocked", "usdtAvailable", "usdtLocked", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Immutable financial double-entry ledger record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "transactionRef": { "type": "string", "minLength": 6, "maxLength": 64 },
        "type": {
          "type": "string",
          "enum": ["deposit", "withdrawal", "investment_open", "investment_return", "investment_principal_return", "referral_bonus", "balance_credit", "balance_debit", "fee"]
        },
        "currency": { "type": "string", "enum": ["USD", "BTC", "USDT"] },
        "amount": { "type": "number" },
        "fee": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed", "cancelled"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "relatedId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "transactionRef", "type", "currency", "amount", "fee", "status", "description", "createdAt"]
    },
    "Deposit": {
      "title": "Deposit",
      "description": "Cryptocurrency deposit request and on-chain verification record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 120 },
        "currency": { "type": "string", "enum": ["BTC", "USDT"] },
        "network": { "type": "string", "maxLength": 40 },
        "depositAddress": { "type": "string", "minLength": 10, "maxLength": 128 },
        "amount": { "type": "number" },
        "txHash": { "type": "string", "minLength": 10, "maxLength": 140 },
        "proofNote": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["pending", "verifying", "confirmed", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "currency", "network", "depositAddress", "amount", "txHash", "status", "createdAt", "updatedAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Cryptocurrency withdrawal payout request.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 120 },
        "currency": { "type": "string", "enum": ["BTC", "USDT"] },
        "network": { "type": "string", "maxLength": 40 },
        "destinationAddress": { "type": "string", "minLength": 10, "maxLength": 128 },
        "amount": { "type": "number" },
        "fee": { "type": "number" },
        "netAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "under_review", "approved", "processing", "completed", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 400 },
        "payoutTxHash": { "type": "string", "maxLength": 140 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "currency", "network", "destinationAddress", "amount", "fee", "netAmount", "status", "createdAt", "updatedAt"]
    },
    "InvestmentPlan": {
      "title": "InvestmentPlan",
      "description": "Algorithmic cryptocurrency investment plan managed by admins.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[a-z0-9\\-]+$" },
        "tagline": { "type": "string", "maxLength": 240 },
        "minAmount": { "type": "number" },
        "maxAmount": { "type": "number" },
        "durationDays": { "type": "integer" },
        "dailyRoi": { "type": "number" },
        "totalRoi": { "type": "number" },
        "riskTier": { "type": "string", "enum": ["Conservative", "Moderate", "Aggressive", "Institutional"] },
        "managementFee": { "type": "number" },
        "returnMethod": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "minAmount", "maxAmount", "durationDays", "dailyRoi", "totalRoi", "riskTier", "managementFee", "returnMethod", "description", "isActive", "updatedAt"]
    },
    "Investment": {
      "title": "Investment",
      "description": "Active or completed investor capital allocation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planName": { "type": "string", "maxLength": 120 },
        "riskTier": { "type": "string", "maxLength": 40 },
        "durationDays": { "type": "integer" },
        "dailyRoi": { "type": "number" },
        "capitalAmount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "USDT"] },
        "dailyReturn": { "type": "number" },
        "totalEarned": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "maturityDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "planId", "planName", "durationDays", "dailyRoi", "capitalAmount", "currency", "dailyReturn", "totalEarned", "startDate", "maturityDate", "status", "createdAt"]
    },
    "KycRecord": {
      "title": "KycRecord",
      "description": "Investor KYC identity submission (strictly owner and admin access).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 120 },
        "fullLegalName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "dateOfBirth": { "type": "string", "maxLength": 24 },
        "residentialAddress": { "type": "string", "maxLength": 240 },
        "city": { "type": "string", "maxLength": 80 },
        "country": { "type": "string", "maxLength": 80 },
        "postalCode": { "type": "string", "maxLength": 32 },
        "idType": { "type": "string", "enum": ["passport", "national_id", "drivers_license"] },
        "idNumber": { "type": "string", "minLength": 3, "maxLength": 80 },
        "idExpiry": { "type": "string", "maxLength": 24 },
        "status": { "type": "string", "enum": ["not_submitted", "pending", "verified", "rejected", "additional_info_required"] },
        "adminNote": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullLegalName", "dateOfBirth", "residentialAddress", "country", "idType", "idNumber", "status", "createdAt", "updatedAt"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Referral attribution link between referrer and referred investor.",
      "type": "object",
      "properties": {
        "referrerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referredId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referredName": { "type": "string", "maxLength": 120 },
        "referredEmail": { "type": "string", "maxLength": 200 },
        "commissionRate": { "type": "number" },
        "totalCommission": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referrerId", "referredId", "commissionRate", "totalCommission", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Account alerts and ledger event notifications.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "message": { "type": "string", "minLength": 1, "maxLength": 600 },
        "type": { "type": "string", "enum": ["success", "warning", "info", "security"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "isRead", "createdAt", "updatedAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support desk ticket metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 120 },
        "ticketCode": { "type": "string", "minLength": 5, "maxLength": 32 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 180 },
        "category": { "type": "string", "enum": ["deposit", "withdrawal", "investment", "kyc", "security", "general"] },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "messageCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "ticketCode", "subject", "category", "priority", "status", "messageCount", "createdAt", "updatedAt"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Individual reply inside a support ticket subcollection.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderRole": { "type": "string", "enum": ["user", "admin"] },
        "senderName": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketId", "senderRole", "senderName", "message", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable compliance log of all administrative actions.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "maxLength": 80 },
        "targetType": { "type": "string", "maxLength": 60 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "adminEmail", "action", "targetType", "details", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Public custodial addresses, fee settings, and compliance flags.",
      "type": "object",
      "properties": {
        "company_name": { "type": "string", "maxLength": 80 },
        "support_email": { "type": "string", "maxLength": 120 },
        "btc_deposit_address": { "type": "string", "maxLength": 128 },
        "usdt_deposit_address": { "type": "string", "maxLength": 128 },
        "btc_min_deposit": { "type": "string", "maxLength": 32 },
        "usdt_min_deposit": { "type": "string", "maxLength": 32 },
        "btc_min_withdrawal": { "type": "string", "maxLength": 32 },
        "usdt_min_withdrawal": { "type": "string", "maxLength": 32 },
        "btc_withdrawal_fee": { "type": "string", "maxLength": 32 },
        "usdt_withdrawal_fee": { "type": "string", "maxLength": 32 },
        "referral_commission_percent": { "type": "string", "maxLength": 16 },
        "kyc_mandatory_for_withdrawal": { "type": "string", "enum": ["true", "false"] },
        "maintenance_mode": { "type": "string", "enum": ["true", "false"] },
        "withdrawal_toast_enabled": { "type": "string", "enum": ["true", "false"] },
        "withdrawal_toast_demo_enabled": { "type": "string", "enum": ["true", "false"] },
        "withdrawal_toast_statuses": { "type": "string", "maxLength": 64 },
        "withdrawal_toast_duration_sec": { "type": "string", "maxLength": 8 },
        "withdrawal_toast_min_interval_sec": { "type": "string", "maxLength": 8 },
        "withdrawal_toast_max_interval_sec": { "type": "string", "maxLength": 8 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["btc_deposit_address", "usdt_deposit_address", "updatedAt"]
    },
    "PublicWithdrawalFeed": {
      "title": "PublicWithdrawalFeed",
      "description": "Sanitized, zero-PII public feed of verified processed/completed withdrawals for floating activity notifications.",
      "type": "object",
      "properties": {
        "maskedIdentifier": { "type": "string", "minLength": 4, "maxLength": 64 },
        "amountUsd": { "type": "number" },
        "cryptoAmount": { "type": "number" },
        "currency": { "type": "string", "enum": ["BTC", "USDT", "USD"] },
        "status": { "type": "string", "enum": ["approved", "processing", "completed"] },
        "processedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["maskedIdentifier", "amountUsd", "cryptoAmount", "currency", "status", "processedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Privileged administrator identity record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "ReferralDirectoryEntry": {
      "title": "ReferralDirectoryEntry",
      "description": "Minimal referral code to UID lookup mapping (zero PII).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Investor profile documents (owner and admin only)."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Investor multi-currency balance sheet."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Immutable double-entry ledger history."
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/Deposit" },
      "description": "BTC and USDT TRC20 deposit submissions."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Crypto withdrawal requests and settlement hashes."
    },
    "/investment_plans/{planId}": {
      "schema": { "$ref": "#/entities/InvestmentPlan" },
      "description": "Publicly browsable investment strategy plans."
    },
    "/investments/{investmentId}": {
      "schema": { "$ref": "#/entities/Investment" },
      "description": "User active and completed investment positions."
    },
    "/kyc_records/{userId}": {
      "schema": { "$ref": "#/entities/KycRecord" },
      "description": "Private KYC verification records."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/Referral" },
      "description": "Referral attribution records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notification inbox."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Support tickets owned by investors."
    },
    "/support_tickets/{ticketId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Support ticket conversation messages subcollection."
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Admin-only immutable audit log."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Platform deposit addresses, minimums, and withdrawal fees."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin UID registry."
    },
    "/referral_codes/{code}": {
      "schema": { "$ref": "#/entities/ReferralDirectoryEntry" },
      "description": "Public referral code lookup mapping (UID only, no PII)."
    },
    "/public_withdrawal_feed/{feedId}": {
      "schema": { "$ref": "#/entities/PublicWithdrawalFeed" },
      "description": "Zero-PII sanitized feed of verified approved, processing, and completed withdrawals."
    }
  }
}
