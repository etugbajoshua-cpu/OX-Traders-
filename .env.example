# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where OX TRADERS is hosted (https://oxtraders.online in production).
APP_URL="https://oxtraders.online"

# JWT_SECRET: Long random secret used to sign user & admin session tokens across restarts.
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"

# OPTION 1 (RECOMMENDED - NO POSTGRESQL NEEDED): Turso Serverless Cloud SQLite
# Create a free forever database at https://turso.tech and paste your URL + Token in Render Environment Variables:
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# OPTION 2: External PostgreSQL (Neon / Supabase / Render)
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL=""

# OPTION 3: Persistent Disk Mount Directory on Render
DATA_DIR="./data"
